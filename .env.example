# Server Configuration
PORT=8080
HOST=0.0.0.0
NODE_ENV=development

# Telegram Bot Credentials
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCDefGhIJKlmNoPQRsTUVwxyZ

# App Mode
# Set DEMO_MODE=true to seed 6 recurring services totaling $85/month with 1 expiring trial alert
DEMO_MODE=true

# Database Path
DATABASE_PATH=./data/renewradar.db

# Default User Currency (EUR, USD, RON, GBP)
DEFAULT_CURRENCY=EUR

# Watchdog Settings (Interval in ms, default 60000 = 60s)
WATCHDOG_INTERVAL_MS=60000

# Mini App Public URL (when hosting or testing with ngrok/localtunnel)
# For local development with long polling, desktop fallback runs directly on localhost
WEBAPP_URL=http://localhost:8080
